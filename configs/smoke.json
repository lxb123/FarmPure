{
  "layers": [1, 2],
  "image_size": [64, 64],
  "model": {
    "num_classes": 1,
    "fusion_dim": 16,
    "decoder_channels": [16, 8, 4],
    "use_cmsf": true
  },
  "loss": {
    "grid_sizes": [16, 32],
    "band_px": 2,
    "equivalent_thickness": 8,
    "soft_steps": 3,
    "max_band_weight": 2.0,
    "warmup_epochs": 3,
    "ce_weight": 1.0,
    "dice_weight": 1.0,
    "aux_weight": 0.1,
    "ignore_index": 255
  },
  "learning_rate": 0.0001,
  "weight_decay": 0.05
}
